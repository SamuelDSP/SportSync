// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum PosicaoJogador {
  GOLEIRO
  DEFENSOR
  MEIO_CAMPO
  ATACANTE
}

enum StatusJogador {
  MERCADO
  ELENCO
  DEMITIDO
}

enum SituacaoFisica {
  DISPONIVEL
  LESIONADO
}

enum GravidadeLesao {
  LEVE
  MODERADA
  GRAVE
}

model Clube {
  id                  Int      @id @default(autoincrement())
  nome                String
  saldo               Float    @default(0)
  limiteDespesaMensal Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  jogadores  Jogador[]
  transacoes TransacaoFinanceira[]
}

model Jogador {
  id                Int             @id @default(autoincrement())
  nome              String
  idade             Int
  valorMercado      Float
  salarioAtual      Float?
  salarioDesejado   Float
  posicao           PosicaoJogador
  status            StatusJogador   @default(MERCADO)
  situacaoFisica    SituacaoFisica  @default(DISPONIVEL)
  gravidadeLesao    GravidadeLesao?
  diasLesaoRestantes Int            @default(0)
  clubeId           Int?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  clube      Clube? @relation(fields: [clubeId], references: [id])
  transacoes TransacaoFinanceira[]
}

model TransacaoFinanceira {
  id        Int           @id @default(autoincrement())
  descricao String
  valor     Float
  tipo      TipoTransacao
  categoria String?
  clubeId   Int?
  jogadorId Int?
  data      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clube   Clube?   @relation(fields: [clubeId], references: [id])
  jogador Jogador? @relation(fields: [jogadorId], references: [id])
}
